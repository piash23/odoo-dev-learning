<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="hospital_patient_sequence" model="ir.sequence">
            <field name="name">Hospital Patient Sequence</field>
            <field name="code">hospital.patient.code</field>
            <field name="prefix">PAT</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="hospital_appointment_sequence" model="ir.sequence">
            <field name="name">Hospital Appointment Sequence</field>
            <field name="code">hospital.appointment.code</field>
            <field name="prefix">APP</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>