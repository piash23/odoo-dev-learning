<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <report
        id="action_report_hospital_patient"
        model="hospital.patient"
        string="Patient Report"
        report_type="qweb-pdf"
        menu="False"
        name="om_hospital.report_hospital_patient"
        file="om_hospital.report_hospital_patient"
        print_report_name="'Patient Report - %s' % (object.name or '')"
    />

    <template id="report_hospital_patient">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                <!-- <div class="page">
                    <h2>Patient Report</h2>
                    <p><strong>Name:</strong> <span t-field="doc.name"/></p>
                    <p><strong>Age:</strong> <span t-field="doc.age"/></p>
                    <p><strong>Gender:</strong> <span t-field="doc.gender"/></p>
                </div> -->
                <div class="page">
                    <br/>
                    <br/>
                    <br/>
                    <br/>
                    <div class="oe_structure"/>
                    <div class="row">
                        <div class="col-xs-2" style="margin:auto">
                            <center>
                                <div class="col-xs-8" style="margin:auto">
                                    <table class="table table-condensed" style="border:3px solid black !important;">
                                        <tr>
                                            <td width="40%">
                                                <p style="text-align:center;padding-top:10px;">
                                                    <img t-if="not doc.image" t-att-src="'/web/static/src/img/placeholder.png'" height="120" width="120"/>
                                                    <img t-if="doc.image" t-att-src="'data:image/png;base64,%s' % to_text(doc.image)" height="120" border="1" width="120"/>
                                                </p>
                                                <p style="text-align:center">
                                                <h2><strong><span t-field="doc.name"></span></strong></h2>
                                                </p>
                                            </td>
                                            <td width="60%">
                                                <table>
                                                    <tr>
                                                        <td>
                                                            <p style="text-align:right"><strong>Contact: </strong></p>
                                                            <p style="text-align:right"><strong>Age: </strong></p>
                                                            <p style="text-align:right"><strong>Ph No:</strong></p>
                                                        </td>
                                                        <td>
                                                            <p style="text-align:left; padding-left:10px;" t-field="doc.name"></p>
                                                            <p style="text-align:left; padding-left:10px;" t-field="doc.age_group"></p>
                                                            <p style="text-align:left; padding-left:10px;" t-field="doc.name"></p>
                                                        </td>
                                                    </tr>
                                                </table>

                                            </td>
                                        </tr>

                                    </table>

                                </div>
                            </center>
                        
                        </div>
                    </div>

                </div>

                </t>
            </t>
        </t>
    </template>


</odoo>