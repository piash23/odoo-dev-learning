<?xml version="1.0" encoding="UTF-8"?>
<odoo>


    <record id="action_hospital_patient_appointments" model="ir.actions.act_window">
        <field name="name">Hospital Appointments</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="domain">[('patient_id', '=', active_id)]</field>
    </record>

    <record id="view_hospital_patient_from" model="ir.ui.view">
        <field name="name">hospital.patient.form</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
           <form string="Hospital Patient">
                <header>
                    <button name="%(action_hospital_appointment_create)d" 
                    string="Create Appointment" 
                    type="action"
                    context="{'default_patient_id': active_id}"
                    class="oe_highlight" />
                </header>
                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_appointments" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="appointment_count" widget="statinfo" string="(O)Appointments"/>
                        </button>
                        <button name="%(action_hospital_patient_appointments)d" type="action" class="oe_stat_button" icon="fa-calendar">
                            <field name="appointment_count" widget="statinfo" string="(A)Appointments"/>
                        </button>
                    </div>


                    <div class="oe_title">
                        <h1>
                            <field name="name_seq" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="age"/>
                        <field name="gender"/>
                        <field name="age_group"/>
                        <field name="doctor_id" options="{'no_create': True, 'no_open': True}"/>
                        <!-- <field name="doctor_id" options="{'no_quick_create': True, 'no_create': True, 'no_create_edit': True}"/> -->
                        <field name="doctor_gender"/>
                        <field name="note"/>
                        <field name="image" widget="image"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activities"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_hospital_patient_tree" model="ir.ui.view">
        <field name="name">hospital.patient.tree</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">

            <tree string="Hospital Patients">
                <field name="name_seq"/>
                <field name="name"/>
                <field name="gender"/>
                <field name="age"/>
                <field name="note"/>
                <field name="age_group"/>
                <field name="image" widget="image"/>
                <field name="doctor_id"/>
                <field name="doctor_gender"/>
            </tree>
        </field>

    </record>

    <record id="view_hospital_patient_search" model="ir.ui.view">
        <field name="name">hospital.patient.search</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <search string="search Patients">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('name_seq', 'ilike', self)]"/>
                <field name="name_seq"/>
                <separator/>
                <filter string="Male" name="male" domain="[('gender', '=', 'male')]"/>
                 <!-- <separator/>        -->      <!--  will make the filters and conditon from or -->
                <filter string="Female" name="female" domain="[('gender', '=', 'female')]"/>

                <group expand="0" string="Group By">
                    <filter string="Gender" name="group_by_gender" context="{'group_by':'gender'}"/>
                </group>   
            </search>
        </field>
    </record>

    <record id="action_hospital_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{ "search_default_male":1 }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first patient
            </p>
        </field>
    </record>

    <menuitem id="hospital_menu_root" name="Hospital" sequence="10"/>
    <menuitem id="hospital_menu_patient" name="Patients" parent="hospital_menu_root" action="action_hospital_patient" sequence="10"/>
    <menuitem id="hospital_menu_create_appointment" name="Create Appointment" parent="hospital_menu_root" action="action_hospital_appointment_create" sequence="20"/>

</odoo>
