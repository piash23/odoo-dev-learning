<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hospital_doctor_form" model="ir.ui.view">
        <field name="name">hospital.doctor.form</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <form string="Hospital Doctor">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active" invisible="1"/>                
                        </group>
                        <group>
                            <field name="gender"/>
                            <field name="related_user_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_hospital_doctor_tree" model="ir.ui.view">
        <field name="name">hospital.doctor.tree</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <tree string="Hospital Doctors">
                <field name="name"/>
                <field name="gender"/>
                <field name="related_user_id"/>
            </tree>
        </field>
    </record>

    <record id="action_hospital_doctor" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">hospital.doctor</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="hospital_menu_doctor" name="Doctor" parent="hospital_menu_root" action="action_hospital_doctor"/>


</odoo>