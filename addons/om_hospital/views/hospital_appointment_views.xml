<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hospital_appointment_form" model="ir.ui.view">
        <field name="name">hospital.appointment.form</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <form string="Hospital Appointment">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" states="draft" class="oe_highlight"/>
                    <button name="action_done" type="object" string="Done" states="confirmed" class="oe_highlight"/>
                    <button name="action_cancel" type="object" string="Cancel" states="draft,confirmed" class="oe_highlight"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" states="cancelled,done" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done,cancelled"/>
                </header>
                <sheet>
                <div class="oe_title oe_inline">
                        <label for="appointment_seq"/>
                        <h1><field name="appointment_seq" placeholder="Appointment Sequence"/></h1>
                    </div>
                    <group>
                        <field name="patient_id"/>
                        <field name="patient_age"/>
                        <field name="doctor_name"/>
                        <field name="appointment_date"/>
                        <field name="notes"/>
                    </group>
                    <notebook name="appointment_notebook">
                        <page string="Doctor's Note" name="doctors_note_page">
                            <group>
                                <field name="doctors_note" widget="html"/>
                            </group>
                        </page>
                        <page string="Prescription" name="prescription_page">
                            <group>
                                <field name="prescription" widget="html"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_appointment_tree" model="ir.ui.view">
        <field name="name">hospital.appointment.tree</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <tree string="Hospital Appointments">
                <field name="patient_id"/>
                <field name="patient_age" sum="Total"/>
                <!-- <field name="patient_age" avg="Average"/> -->
                <field name="doctor_name"/>
                <field name="appointment_date"/>
            </tree>
        </field>
    </record>

    <record id="action_hospital_appointment" model="ir.actions.act_window">
        <field name="name">Hospital Appointments</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new hospital appointment.
            </p>
        </field>
    </record>
    <menuitem id="hospital_menu_appointment" name="Appointments" parent="hospital_menu_root" action="action_hospital_appointment" sequence="10"/>

</odoo>